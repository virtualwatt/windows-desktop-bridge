# windows-desktop-bridge environment.
# Copy this file to ".env" in the project root (next to
# windows_desktop_bridge.py) and fill in your values.
# Never commit the real .env - it is in .gitignore.
# Real environment variables win over this file.

# Bearer token the MCP client must present. Generate one, e.g.
# openssl rand -hex 32. Required - the bridge refuses to start
# without it.
BRIDGE_TOKEN=

# Interface the bridge listens on. Keep 127.0.0.1 when Tailscale
# Funnel exposes the port.
BRIDGE_HOST=127.0.0.1

# OBS WebSocket connection (Tools -> WebSocket Server Settings).
OBS_WS_HOST=127.0.0.1
OBS_WS_PORT=4455
# Only if OBS WebSocket authentication is enabled.
OBS_WS_PASSWORD=

# OBS profile used for recording when connect gets no profile.
OBS_PROFILE=Work

# Installer only (install_tailscale.bat). Leave empty for the
# interactive browser login.
TAILSCALE_AUTHKEY=
# Optional machine name in the tailnet.
TAILSCALE_HOSTNAME=
